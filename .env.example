# GCP Settings
GCP_PROJECT_ID=studio-shotwot-XXXXX
GCP_REGION=asia-south1

# GCS Buckets Settings
GCS_VAULT_BUCKET=shotwot-brand-vault-poc
GCS_OUTPUT_BUCKET=shotwot-generated-outputs-poc

# Firebase Admin
FIREBASE_PROJECT_ID=shotwot-studio-poc

# Cloud Run: the service account email the backend runs as.
# Required for generating GCS signed URLs via IAM on Cloud Run.
# Leave empty for local dev (uses service account key file instead).
SERVICE_ACCOUNT_EMAIL=shotwot-backend-sa@studio-shotwot-XXXXX.iam.gserviceaccount.com

# Cloud Run: set this after deploying the frontend so CORS is restricted.
FRONTEND_URL=https://shotwot-frontend-xxx-el.a.run.app

# App Settings
PORT=8000
ENVIRONMENT=development
